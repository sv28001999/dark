# Copy to .env and adjust. Real environment variables override values in .env.

NODE_ENV=development
PORT=3000

# Firebase Realtime Database URL (accessed through its public REST API, no credentials)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Firebase service account key, for sending push notifications (FCM). Optional: without it notifications are
# only logged. Firebase console > Project settings > Service accounts > Generate new private key, then paste the
# file's contents here on one line, in single quotes. Keep it secret: it can send notifications as your app.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Folder containing the runnable .js scripts
SCRIPTS_DIR=./scripts
# A script still running after this many milliseconds is killed (5 minutes)
SCRIPT_TIMEOUT_MS=300000
# Maximum number of scripts running at the same time
MAX_CONCURRENT_RUNS=5

# Polymarket APIs: CLOB (trading, server time) and Gamma (market/event data)
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# Trading: "simulated" (default) only saves each buy as a trade; "live" places REAL orders with REAL money.
TRADING_MODE=simulated
# Secret the trading endpoints require in the X-Api-Key header (the mobile app sends it as
# EXPO_PUBLIC_TRADING_API_KEY). At least 16 characters; required for live trading.
# TRADING_API_KEY=
# Live trading account. Private key: polymarket.com > profile > Settings > Export private key (it controls your
# funds: never share it or commit it). Wallet address: the account wallet shown in the profile menu.
# POLYMARKET_PRIVATE_KEY=0x...
# POLYMARKET_WALLET_ADDRESS=0x...
# Optional, for redeeming winnings with gasless transactions: polymarket.com > Settings > API Keys > Relayer
# API Keys (the API key and its signer address).
# POLYMARKET_RELAYER_API_KEY=
# POLYMARKET_RELAYER_API_KEY_ADDRESS=0x...

# "*" or a comma-separated list of allowed origins
CORS_ORIGIN=*

# Number of reverse proxies in front of the app (0 when exposed directly)
TRUST_PROXY=0

# Max requests per IP per window on /api routes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# fatal | error | warn | info | debug | trace | silent (default: debug in development, info in production)
# LOG_LEVEL=info
